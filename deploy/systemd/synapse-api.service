[Unit]
Description=Synapse API
After=network.target postgresql.service

[Service]
Type=simple
User=azureuser
WorkingDirectory=/opt/synapse/backend
EnvironmentFile=/opt/synapse/backend/.env
ExecStart=/opt/synapse/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8011
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
